# Public site URL — used for canonical links, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://dede-portfolio.vercel.app

# Optional: enable live answers from OpenRouter in the portfolio assistant.
NEXT_PUBLIC_AI_CHAT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=https://dede-portfolio.vercel.app
OPENROUTER_APP_NAME=Dieu Donné Portfolio
